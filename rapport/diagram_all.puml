}

' ====================================
' RELATIONS — MODEL
' ====================================

ArchiveRoom "1" *-- "1"      Environment       : has
ArchiveRoom "1" o-- "0..4"   Wall              : contains

Wall      "1" *-- "1..*"     Cell              : contains
Cell           -->            CellState
Cell           -->            MoldSpecies
Cell           -->            WallMaterial

Shelf          -->            ShelfValue

MoldSensor "1" -->  "1"      Wall              : monitors
MoldSensor "1" -->  "0..*"   Shelf             : watches
MoldSensor     -->            AlertLevel
MoldSensor "1" ..>  "0..*"   SensorEvent       : creates

SensorEvent    -->            Wall
SensorEvent    -->            AlertLevel
SensorEvent    -->            EventType
SensorEvent "0..*" --> "0..1" Shelf

Statistics "1" -->  "1"      Wall              : analyzes

RecommendationEngine "1" --> "1"  ArchiveRoom
RecommendationEngine       ..>     SensorEvent

PdfExporter    ..>            Statistics
PdfExporter    ..>            Environment

SimulationSnapshot     -->    WallMaterial

SimulationState "1" *-- "1..*"  WallContext     : saves
SimulationState "1" *-- "0..*"  SimulationSnapshot
SimulationState        -->       Environment

BinaryExporter         ..>       SimulationState

EventManager "1" -->  "1"    Environment
EventManager           -->    ExternalEvent
EventManager           ..>    Wall
EventManager           ..>    Shelf

WallContext  "1" *-- "1"     Wall              : owns
WallContext  "1" *-- "0..*"  Shelf             : has
WallContext  "1" --> "1"     SimulationController : owns

WallManager  "1" *-- "1..4"  WallContext       : manages

' ====================================
' RELATIONS — CONTROLLER
' ====================================

SimulationController "1" --> "1"     ArchiveRoom
SimulationController "1" --> "1"     Environment
SimulationController "1" *-- "1..*"  MoldSensor
SimulationController "1" *-- "1"     AlertController
SimulationController "1" --> "1"     EventManager
SimulationController       ..>       RecommendationEngine : creates

AlertController "1" --> "0..*"  SensorEvent
AlertController "1" --> "1"     RecommendationEngine

GridController  "1" --> "1"     MainView
GridController  "1" --> "1"     GridView
GridController  "1" --> "1"     SimulationController
GridController  "1" --> "1"     Wall
GridController  "1" --> "1"     Environment
GridController  "1" --> "0..*"  Shelf
GridController  "1" --> "1"     LocationContext
GridController  "1" --> "0..*"  SimulationSnapshot
GridController  "1" --> "1"     WallManager
GridController       -->        ExternalEvent
GridController  "1" --> "1"     PdfExportService

WallConfigDialog ..> WallMaterial
WallConfigDialog ..> WallConfig  : creates

PdfExportService ..> SimulationSnapshot
PdfExportService ..> WallContext
PdfExportService ..> Environment
PdfExportService ..> SimulationController
PdfExportService ..> PdfExporter

AlertController ..|> AlertLogger

' ====================================
' RELATIONS — VIEW
' ====================================

MainView "1" *-- "1"     GridView
MainView "1" *-- "2"     WallPreviewView

GridView       --> "1"   SimulationController
GridView       --> "1"   Wall
GridView       -->       ShelfValue
GridView       -->       DrawMode
GridView       -->       InteractionMode

WallPreviewView --> "1"  Wall

' ====================================
' RELATIONS — APP
' ====================================

Main --> "1"   MainView          : creates
Main --> "1"   GridController    : creates
Main ..>       WallConfigDialog  : uses

@enduml
